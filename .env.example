# =============================================================================
# breaktheloop.site — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# =============================================================================

# --- Public site URL (no trailing slash) ---------------------------------------
NEXT_PUBLIC_SITE_URL=https://breaktheloop.site

# --- Supabase ------------------------------------------------------------------
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Resend (transactional email) ----------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Verified sender domain + recipient
RESEND_FROM_EMAIL=hello@breaktheloop.site
RESEND_TO_EMAIL=camille@breaktheloop.site

# --- Upstash Redis (rate limiting) ---------------------------------------------
# https://console.upstash.com/redis → REST API
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AY...

# --- Cloudflare Turnstile (anti-bot) -------------------------------------------
# https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# --- Server-side salt used to hash visitor IPs (never stored in clear) ---------
# Generate with: openssl rand -hex 32
SECRET_IP_SALT=change-me-openssl-rand-hex-32

# --- Build metadata (auto-injected by Vercel, override locally if needed) ------
# VERCEL_GIT_COMMIT_SHA is set at build time on Vercel; next.config.ts mirrors
# it to NEXT_PUBLIC_COMMIT_SHA for the footer. No need to set it locally.
# NEXT_PUBLIC_COMMIT_SHA=

# --- Node env (usually auto-set) -----------------------------------------------
# NODE_ENV=development
