# =============================================================================
# BREAK THE LOOP — environment template
# Copy to .env.local (dev) or .env.production (VPS), then fill in.
# NEVER commit a populated env file.
# =============================================================================

# --- Public site URL (no trailing slash) ------------------------------------
NEXT_PUBLIC_SITE_URL=https://breaktheloop.fr

# --- Supabase --------------------------------------------------------------
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- LLM providers (free tiers) --------------------------------------------
# Google AI Studio — primary cible (1500 req/jour, Gemini 2.5 Flash)
GEMINI_API_KEY=
# Cerebras — judges + fallback (1M tok/jour, Llama 3.3 70B)
CEREBRAS_API_KEY=
# OpenRouter — secondary fallback (200 req/jour)
OPENROUTER_API_KEY=

# --- Upstash Redis (rate limit + quota tracking) ---------------------------
# https://console.upstash.com/redis → REST API
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AY...

# --- Server-side salts -----------------------------------------------------
# Generate each with: openssl rand -hex 32
SECRET_IP_SALT=change-me-openssl-rand-hex-32
SCORE_HMAC_SECRET=change-me-openssl-rand-hex-32

# --- Cron auth (daily challenge rotation, leaderboard refresh) -------------
CRON_SECRET=change-me-openssl-rand-hex-32

# --- Build metadata --------------------------------------------------------
# Set automatically by CI; can leave blank locally.
NEXT_PUBLIC_COMMIT_SHA=
